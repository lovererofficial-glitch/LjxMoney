# Supabase public client configuration (safe to expose — protected by RLS).
# Copy this file to .env.local and fill in your project's values from
# Supabase Dashboard -> Project Settings -> API.
# Never put a service-role / secret key here or anywhere in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
